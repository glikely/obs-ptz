{
	"Name": "PTZ Controls",
	"Version": "0.1.0.0",
	"Author": "Grant Likely",
	"Actions": [
		{
			"Name": "Move",
			"UUID": "ca.secretlab.obs-ptz.move",
			"Icon": "imgs/actions/move/icon",
			"Tooltip": "Moves a camera while the key is held.",
			"PropertyInspectorPath": "ui/move.html",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/move/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Autofocus",
			"UUID": "ca.secretlab.obs-ptz.autofocus",
			"Icon": "imgs/actions/autofocus/icon",
			"Tooltip": "Turns a camera's autofocus on and off, and lights up while it is on.",
			"PropertyInspectorPath": "ui/autofocus.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{ "Image": "imgs/actions/autofocus/key", "TitleAlignment": "bottom" },
				{ "Image": "imgs/actions/autofocus/key-on", "TitleAlignment": "bottom" }
			]
		},
		{
			"Name": "Command",
			"UUID": "ca.secretlab.obs-ptz.command",
			"Icon": "imgs/actions/command/icon",
			"Tooltip": "Stops a camera, sends it home, saves its home, focuses or sets its white balance once, or turns its power on and off.",
			"PropertyInspectorPath": "ui/command.html",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"States": [{ "Image": "imgs/actions/command/key", "TitleAlignment": "bottom" }]
		},
		{
			"Name": "Camera status",
			"UUID": "ca.secretlab.obs-ptz.status",
			"Icon": "imgs/actions/status/icon",
			"Tooltip": "Shows where a camera is, and whether it is there.",
			"PropertyInspectorPath": "ui/status.html",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"States": [{ "Image": "imgs/actions/status/key", "TitleAlignment": "middle" }]
		},
		{
			"Name": "Axis",
			"UUID": "ca.secretlab.obs-ptz.lens",
			"Icon": "imgs/actions/lens/icon",
			"Tooltip": "Pans, tilts, zooms or focuses a camera, and shows where it is.",
			"PropertyInspectorPath": "ui/lens.html",
			"Controllers": ["Encoder"],
			"SupportedInMultiActions": false,
			"Encoder": {
				"layout": "layouts/track.json",
				"Icon": "imgs/actions/lens/icon",
				"TriggerDescription": {
					"Rotate": "Move the axis",
					"Push": "Autofocus on or off (focus)"
				}
			},
			"States": [{ "Image": "imgs/actions/lens/icon" }]
		},
		{
			"Name": "Preset",
			"UUID": "ca.secretlab.obs-ptz.preset",
			"Icon": "imgs/actions/preset/icon",
			"Tooltip": "Recalls a camera's preset, and lights up while the camera is there.",
			"PropertyInspectorPath": "ui/preset.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/preset/key",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/actions/preset/key-at",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "PTZ Controls",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Moves the cameras of OBS's PTZ Controls, and recalls their presets, over obs-websocket.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "ca.secretlab.obs-ptz"
}
