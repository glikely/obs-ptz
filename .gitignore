# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/scripts
!/src
!/shared
!/tests
!.clang-format
!.gersemirc
!.gitignore
!.mailmap
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md
!installer-Windows.iss.in
!*.md
!crowdin.yml

# Exclude lock files
*.lock.json

# Exclude Python bytecode caches
__pycache__/
*.pyc

# Exclude macOS legacy resource forks
.DS_Store

# Exclude Python bytecode cache
__pycache__/
*.pyc

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
